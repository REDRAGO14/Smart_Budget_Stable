<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartbudget.controllers.LoginController" prefWidth="900" prefHeight="600">
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 50;">
            <!-- Title -->
            <Label text="Smart Budget Manager" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <VBox.margin>
                    <Insets bottom="20" />
                </VBox.margin>
            </Label>
            
            <!-- Subtitle -->
            <Label text="Login to your account" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;">
                <VBox.margin>
                    <Insets bottom="30" />
                </VBox.margin>
            </Label>
            
            <!-- Login Form -->
            <VBox spacing="15" maxWidth="350" style="-fx-border-color: #ecf0f1; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 30; -fx-style-class: 'form-container';">
                
                <!-- Username Field -->
                <VBox spacing="5">
                    <Label text="Username" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <TextField fx:id="usernameField" promptText="Enter your username" />
                </VBox>
                
                <!-- Password Field -->
                <VBox spacing="5">
                    <Label text="Password" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <PasswordField fx:id="passwordField" promptText="Enter your password" />
                </VBox>
                
                <!-- Error Message -->
                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" wrapText="true">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                </Label>
                
                <!-- Login Button -->
                <Button fx:id="loginButton" text="Login" style="-fx-font-size: 14; -fx-padding: 10; -fx-font-weight: bold;" onAction="#onLoginClick">
                    <VBox.margin>
                        <Insets top="15" />
                    </VBox.margin>
                </Button>
                
            </VBox>
            
            <!-- Register Link -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Don't have an account?" />
                <Hyperlink text="Register here" onAction="#onRegisterClick" style="-fx-font-size: 12;" />
            </HBox>
            
        </VBox>
    </center>
</BorderPane>

