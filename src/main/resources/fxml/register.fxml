<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartbudget.controllers.RegisterController" prefWidth="900" prefHeight="600">
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
            <!-- Title -->
            <Label text="Create New Account" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <VBox.margin>
                    <Insets bottom="20" />
                </VBox.margin>
            </Label>
            
            <!-- Registration Form -->
            <VBox spacing="15" maxWidth="350" style="-fx-border-color: #ecf0f1; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 30;">
                
                <!-- Username Field -->
                <VBox spacing="5">
                    <Label text="Username" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <TextField fx:id="usernameField" promptText="Choose a username" />
                </VBox>
                
                <!-- Email Field -->
                <VBox spacing="5">
                    <Label text="Email" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <TextField fx:id="emailField" promptText="Enter your email" />
                </VBox>
                
                <!-- Password Field -->
                <VBox spacing="5">
                    <Label text="Password" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <PasswordField fx:id="passwordField" promptText="Create a password (min 6 chars)" />
                </VBox>
                
                <!-- Confirm Password Field -->
                <VBox spacing="5">
                    <Label text="Confirm Password" style="-fx-font-weight: bold;">
                        <font>
                            <Font size="12" />
                        </font>
                    </Label>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" />
                </VBox>
                
                <!-- Error Message -->
                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" wrapText="true">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                </Label>
                
                <!-- Register Button -->
                <Button fx:id="registerButton" text="Register" style="-fx-font-size: 14; -fx-padding: 10; -fx-font-weight: bold;" onAction="#onRegisterClick">
                    <VBox.margin>
                        <Insets top="15" />
                    </VBox.margin>
                </Button>
                
            </VBox>
            
            <!-- Back to Login Link -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?" />
                <Hyperlink text="Back to login" onAction="#onBackClick" style="-fx-font-size: 12;" />
            </HBox>
            
        </VBox>
    </center>
</BorderPane>

