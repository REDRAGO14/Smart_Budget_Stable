<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartbudget.controllers.ExpenseController" prefWidth="900" prefHeight="600">
    <!-- Top Nav Bar -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER_LEFT">
            <Label text="Transaction Management" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Back to Dashboard" onAction="#onBackClick" style="-fx-font-size: 12; -fx-padding: 8; -fx-font-weight: bold; -fx-background-color: #34495e; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white;">
            <!-- Tab 1: Expense Log -->
            <Tab text="Expenses">
                <HBox spacing="20" style="-fx-padding: 20;">
                    <!-- Left: Form -->
                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5;" minWidth="300" maxWidth="300">
                        <Label text="Add New Expense" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        
                        <!-- Category Input -->
                        <VBox spacing="5">
                            <Label text="Category" style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="expenseCategoryComboBox" promptText="Select Category" style="-fx-max-width: Infinity;" />
                        </VBox>

                        <!-- Amount Input -->
                        <VBox spacing="5">
                            <Label text="Amount (ETB)" style="-fx-font-weight: bold;" />
                            <TextField fx:id="expenseAmountField" promptText="e.g. 24.50" />
                        </VBox>

                        <!-- Description Input -->
                        <VBox spacing="5">
                            <Label text="Description" style="-fx-font-weight: bold;" />
                            <TextField fx:id="expenseDescriptionField" promptText="e.g. Weekly Groceries" />
                        </VBox>

                        <!-- Date Input -->
                        <VBox spacing="5">
                            <Label text="Date" style="-fx-font-weight: bold;" />
                            <DatePicker fx:id="expenseDatePicker" style="-fx-max-width: Infinity;" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Save Action -->
                        <Button text="Save Expense" onAction="#onSaveExpenseClick" style="-fx-max-width: Infinity; -fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                    </VBox>

                    <!-- Right: Table View -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Expense Records" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Delete Selected" onAction="#onDeleteExpenseClick" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" />
                        </HBox>
                        <TableView fx:id="expenseTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="expenseIdCol" text="ID" prefWidth="50" />
                                <TableColumn fx:id="expenseCategoryCol" text="Category" prefWidth="120" />
                                <TableColumn fx:id="expenseAmountCol" text="Amount (ETB)" prefWidth="100" />
                                <TableColumn fx:id="expenseDescriptionCol" text="Description" prefWidth="200" />
                                <TableColumn fx:id="expenseDateCol" text="Date" prefWidth="100" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </HBox>
            </Tab>

            <!-- Tab 2: Income Log -->
            <Tab text="Income">
                <HBox spacing="20" style="-fx-padding: 20;">
                    <!-- Left: Form -->
                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5;" minWidth="300" maxWidth="300">
                        <Label text="Add New Income" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                        <!-- Amount Input -->
                        <VBox spacing="5">
                            <Label text="Amount (ETB)" style="-fx-font-weight: bold;" />
                            <TextField fx:id="incomeAmountField" promptText="e.g. 500.00" />
                        </VBox>

                        <!-- Description Input -->
                        <VBox spacing="5">
                            <Label text="Description" style="-fx-font-weight: bold;" />
                            <TextField fx:id="incomeDescriptionField" promptText="e.g. Monthly Salary" />
                        </VBox>

                        <!-- Date Input -->
                        <VBox spacing="5">
                            <Label text="Date" style="-fx-font-weight: bold;" />
                            <DatePicker fx:id="incomeDatePicker" style="-fx-max-width: Infinity;" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Save Action -->
                        <Button text="Save Income" onAction="#onSaveIncomeClick" style="-fx-max-width: Infinity; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                    </VBox>

                    <!-- Right: Table View -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Income Records" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Delete Selected" onAction="#onDeleteIncomeClick" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" />
                        </HBox>
                        <TableView fx:id="incomeTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="incomeIdCol" text="ID" prefWidth="50" />
                                <TableColumn fx:id="incomeAmountCol" text="Amount (ETB)" prefWidth="120" />
                                <TableColumn fx:id="incomeDescriptionCol" text="Description" prefWidth="250" />
                                <TableColumn fx:id="incomeDateCol" text="Date" prefWidth="120" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </HBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
